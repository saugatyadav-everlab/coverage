# The design system bundle and fonts are content-addressed by their folder name
# and never change in place — cache them hard.
/ds/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Vite fingerprints its own output.
/assets-app/*
  Cache-Control: public, max-age=31536000, immutable

# This page is designed to be framed by the Everlab app. Replace the
# frame-ancestors list with your real origins before going live — the default
# below allows any origin, which is what a wildcard preview deploy needs but not
# what you want in production.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow
  Content-Security-Policy: frame-ancestors *
